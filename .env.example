# Copy this file to .env and fill in your own values.
# Supabase: Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Agora: console.agora.io > your project > App ID
# (the App Certificate goes in Supabase secrets, never in the app)
EXPO_PUBLIC_AGORA_APP_ID=YOUR-AGORA-APP-ID

# AdMob rewarded ad units (optional until launch; Google's test ads are used without them).
# The AdMob *app* IDs go in app.json under the react-native-google-mobile-ads plugin.
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
