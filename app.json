{
  "expo": {
    "name": "Nooks Owl",
    "slug": "nooksowl",
    "scheme": "nooksowl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nooksowl.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Nooks Owl uses your microphone for voice calls and voice notes.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.nooksowl.app",
      "adaptiveIcon": {
        "backgroundColor": "#C2410C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Nooks Owl uses your microphone for voice calls and voice notes."
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 336,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F3",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#121317"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
